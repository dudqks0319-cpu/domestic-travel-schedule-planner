{
  "name": "tripmate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "npm --prefix packages/planner run test",
    "check:env": "node scripts/dev-readiness-check.mjs",
    "check:env:preview": "node scripts/dev-readiness-check.mjs --target preview",
    "check:env:production": "node scripts/dev-readiness-check.mjs --target production",
    "check:secrets:preview": "node scripts/check-cloudflare-secrets.mjs --target preview",
    "check:secrets:production": "node scripts/check-cloudflare-secrets.mjs --target production",
    "d1:plan:preview": "node scripts/d1-migrate.mjs --target preview --plan",
    "d1:plan:production": "node scripts/d1-migrate.mjs --target production --confirm-production --plan",
    "d1:migrate:preview": "node scripts/d1-migrate.mjs --target preview",
    "d1:migrate:production": "node scripts/d1-migrate.mjs --target production --confirm-production",
    "check:release-contract": "node scripts/release-contract-check.mjs",
    "check:health": "npm run mobile:typecheck && npm run api:build && npm run planner:build && npm run worker:typecheck",
    "check:dev": "npm run check:env && npm run check:release-contract && npm run check:health",
    "release:preview:gate": "node scripts/preview-release-gate.mjs",
    "release:production:gate": "node scripts/production-release-gate.mjs",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:web": "npm --prefix apps/mobile run web",
    "mobile:web:qa": "npm --prefix apps/mobile run web:qa",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "api:dev": "npm --prefix services/api run dev",
    "api:build": "npm --prefix services/api run build",
    "api:start": "npm --prefix services/api run start",
    "api:smoke:local": "npm --prefix services/api run smoke:local",
    "api:smoke:gate": "sh -c 'npm run -s api:start >/tmp/tripmate-api.log 2>&1 & API_PID=$!; trap \"kill $API_PID >/dev/null 2>&1 || true\" EXIT INT TERM; i=0; until curl -fsS http://127.0.0.1:4000/health >/dev/null 2>&1; do i=$((i+1)); if [ $i -ge 30 ]; then echo \"[gate] API did not become ready on :4000\"; exit 1; fi; sleep 1; done; npm run -s api:smoke:local'",
    "planner:build": "npm --prefix packages/planner run build",
    "worker:dev": "npm --prefix services/api-worker run dev",
    "worker:typecheck": "npm --prefix services/api-worker run typecheck",
    "worker:smoke": "node scripts/worker-v1-smoke.mjs",
    "worker:smoke:local": "node scripts/worker-local-smoke.mjs",
    "worker:smoke:naver": "node scripts/worker-v1-smoke.mjs --require-provider naver",
    "worker:deploy:preview": "npm --prefix services/api-worker run deploy:preview",
    "gate:local": "npm run -s check:env && npm run -s mobile:typecheck && npm run -s api:build && npm run -s planner:build && npm run -s api:smoke:gate"
  },
  "devDependencies": {
    "@types/react": "~19.0.10"
  }
}
