{
  "expo": {
    "name": "TripMate",
    "slug": "tripmate-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tripmate",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripmate.app"
    },
    "android": {
      "package": "com.tripmate.app"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
